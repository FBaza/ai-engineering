# Elige el proveedor con LLM_PROVIDER (anthropic | openai) y pon solo la
# clave del que vayas a usar (la otra puede quedar vacia).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLM_PROVIDER=anthropic
# claude-haiku-4-5 si LLM_PROVIDER=anthropic, gpt-4o-mini si LLM_PROVIDER=openai
LLM_MODEL=claude-haiku-4-5
APP_ENV=development
LOG_LEVEL=INFO
